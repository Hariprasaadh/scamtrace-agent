# ScamTrace Agent Configuration
# Copy this file to .env and fill in your values

# API Security
API_KEY=your-secret-api-key-here

# Groq LLM Configuration
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# GUVI Callback
GUVI_CALLBACK_URL=https://hackathon.guvi.in/api/updateHoneyPotFinalResult

# Session Management
SESSION_TTL_MINUTES=30

# Detection Thresholds (tuned for high recall — prefer false positives over missed scams)
RULE_HIGH_THRESHOLD=0.75
RULE_LOW_THRESHOLD=0.2
ML_HIGH_THRESHOLD=0.55
ML_LOW_THRESHOLD=0.3

# Engagement Settings
MAX_MESSAGES_WITHOUT_INTEL=10
MIN_MESSAGES_FOR_CALLBACK=3
MAX_CONVERSATION_MESSAGES=10  # 10 turns → scores max turn-count points

# LLM context limits (optional; avoid token overflow from long conversation history)
# AGENT_MAX_HISTORY_MESSAGES=12
# AGENT_MAX_MESSAGE_CHARS=400
# AGENT_MAX_SYSTEM_PROMPT_CHARS=3000
# LLM_DETECTOR_MAX_HISTORY_MESSAGES=5
# LLM_DETECTOR_MAX_MESSAGE_CHARS=300
